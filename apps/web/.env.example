# Copy to .env.local for local dev. NEXT_PUBLIC_* values are inlined into the browser bundle at
# build time, so they're public by definition — never put a secret here.

# Where apps/api is reachable from the browser. Sign-in, sign-up and the session all go there
# (credentials: include; the API sets the HttpOnly zuula_session cookie). The cookie is
# SameSite=Lax, so the browser must see the site and the API as the same site. Two setups work:
#
# 1. Proxy (any hosts, e.g. Vercel + Render): the browser calls this site, which forwards
#    /api/v1/* to the API (next.config.ts). Set both:
#      NEXT_PUBLIC_API_URL=/
#      ZUULA_API_ORIGIN=https://zuula-api.onrender.com   # server-side only, read at build time
# 2. Direct (sibling hosts only: localhost:3000 → localhost:8000, zuula.ug → api.zuula.ug):
#      NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Either way the API's ZUULA_CORS_ORIGINS must list this site's exact origin (its CSRF check
# refuses cookie-authenticated writes from anywhere else). Unset in development, it falls back
# to http://localhost:8000 (direct); unset in a production build, sign-in is disabled.
NEXT_PUBLIC_API_URL=http://localhost:8000
ZUULA_API_ORIGIN=

# "api" or "demo". Unset: real sign-in whenever an API address is known (always in development),
# and the browser-only demo sign-in (lib/demo-auth.ts: any password, role from the address,
# any 6-digit code except 000000) in a production build without NEXT_PUBLIC_API_URL, which is
# the deployed site until the API is hosted. Set it to force either.
NEXT_PUBLIC_AUTH_MODE=

# ---- Supabase Auth ----
# Get these from: Supabase Dashboard → Settings → API Keys
# Project URL: https://xxx.supabase.co
# Publishable key: The "default" publishable key (sb_publishable_..., safe for frontend)
# When set, the app uses Supabase Auth (lib/supabase.ts) instead of the custom/demo auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "true" shows the "Preview as" bar: look at role-gated screens (mock content) as a sample user
# while signed out. A UI preview only — it grants nothing in the API. Leave unset in production.
# In demo mode the bar is the "Demo: view as" switcher and is on unless this is "false".
NEXT_PUBLIC_ROLE_SWITCHER=
