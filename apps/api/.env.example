# Copy to .env for local dev. No real secrets — every value here is a placeholder or a safe
# default. Never commit a real .env.

# ---- Core app ----
ZUULA_ENV=development
ZUULA_DEBUG=true
ZUULA_SECRET_KEY=change-me-dev-only
ZUULA_SESSION_COOKIE_NAME=zuula_session
# Production: zuula.ug (the API is api.zuula.ug, the web app zuula.ug). Empty = host-only.
ZUULA_SESSION_COOKIE_DOMAIN=
ZUULA_SESSION_COOKIE_SECURE=true
ZUULA_CORS_ORIGINS=http://localhost:3000
# Where OAuth sign-in sends the browser back to (the web app, not this API).
ZUULA_WEB_APP_URL=http://localhost:3000
# Seconds one notification-stream connection stays open (EventSource then reconnects).
ZUULA_NOTIFICATION_STREAM_SECONDS=300

# ---- Database (PostgreSQL 16 + pgvector; migrations: `alembic upgrade head`) ----
# Supabase: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Local Docker: postgresql+asyncpg://zuula:zuula@postgres:5432/zuula
DATABASE_URL=postgresql+asyncpg://zuula:zuula@postgres:5432/zuula
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false
# tests/db/ drops and recreates this database on every run — never point it at real data.
TEST_DATABASE_URL=postgresql+asyncpg://zuula:zuula@localhost:5432/zuula_test

# ---- Supabase Auth (JWT verification) ----
# Get these from: Supabase Dashboard → Settings → API / JWT Keys
# SUPABASE_URL: Your project URL (https://xxx.supabase.co)
# SUPABASE_JWT_SECRET: legacy JWT secret, only for HS256 tokens (signing keys are fetched from JWKS)
# The service_role key is NOT needed here — it's only for Supabase admin operations.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# "supabase" verifies Supabase access tokens; "legacy" keeps the zuula_session cookie auth.
# Leave "legacy" until Phase 1.2 wires Supabase into app/core/security.py.
ZUULA_AUTH_PROVIDER=legacy

# ---- Redis / Celery ----
# Separate DB indices so a FLUSHDB on one doesn't take out the others.
REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# celery (a worker process) or inline (jobs inside the API, for one free-tier instance
# with no worker; then only REDIS_URL is used, and a single-database Redis like Upstash's
# free plan is fine: rediss://default:<password>@<host>:6379).
JOB_RUNNER=celery

# ---- Partner API ----
ZUULA_PARTNER_RATE_LIMIT_PER_HOUR=100

# ---- Integrations (app/adapters/) ----
# Each adapter is real once its values are set, and a logging stub otherwise. With
# ZUULA_ENV=production every one is required: the API and worker refuse to start on a stub,
# unless the adapter is listed here. Ids: google, facebook, sms, email, turnstile, clamav, s3,
# whatsapp, telegram. In production an unconfigured Google/Facebook sign-in is unavailable
# and an unconfigured WhatsApp/Telegram webhook refuses every call. Leave empty for a full
# launch; e.g. a demo without chat channels: ZUULA_ALLOW_STUB_ADAPTERS=whatsapp,telegram
ZUULA_ALLOW_STUB_ADAPTERS=

# ---- OAuth: Google / Facebook sign-in ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

# ---- Africa's Talking SMS (`sandbox` = their simulator; production needs your app username) ----
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=

# ---- Cloudflare Turnstile (FR-AUTH-07) ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- ClamAV (media malware scans; docker-compose.yml sets CLAMAV_HOST=clamav for the worker) ----
CLAMAV_HOST=
CLAMAV_PORT=3310

# ---- S3-compatible storage (production: Supabase Storage, https://<project>.supabase.co/storage/v1/s3,
# bucket zuula-documents; also AWS S3, R2, MinIO…; empty endpoint = AWS). Empty keys = in-memory stub.
S3_ENDPOINT_URL=
S3_BUCKET=zuula-media-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# ---- Email: Brevo's HTTPS API (preferred when set; needed where SMTP ports are blocked,
# e.g. Render's free tier), else SMTP (STARTTLS on 587, TLS on 465) ----
EMAIL_FROM=hello@zuula.ug
BREVO_API_KEY=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# ---- WhatsApp Cloud API / Telegram Bot (FR-SUBMIT-04) ----
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The Meta app's App Secret: verifies X-Hub-Signature-256 on every inbound webhook call.
WHATSAPP_APP_SECRET=
TELEGRAM_BOT_TOKEN=
# The secret_token you pass to setWebhook; Telegram sends it back on every call.
TELEGRAM_WEBHOOK_SECRET=

# ---- Sunbird AI: language detection and translation (app/providers/language.py, ADR 0003) ----
# LANGUAGE_PROVIDER: empty = Sunbird when SUNBIRD_API_KEY is set, the stub otherwise; or
# `sunbird` / `stub` explicitly. Get a key from Sunbird AI; never commit it.
LANGUAGE_PROVIDER=
SUNBIRD_API_URL=https://api.sunbird.ai
SUNBIRD_API_KEY=

# ---- Verdict engine (AnalysisProvider, app/providers/analysis.py — P4) ----
# Sending submissions to a hosted LLM outside Uganda is an open §10.1 data-protection
# question; keep this switchable/region-configurable rather than hardcoded. `groq` uses
# a free-tier hosted model on Groq — no Claude/Anthropic calls anywhere in this engine, per
# the P4 cost constraint.
ANALYSIS_PROVIDER=
ANALYSIS_PROVIDER_REGION=
# Pads pipeline steps that finish early up to their display times (app/services/pipeline_steps.py).
# 1.0 paces local dev with stub providers like the demo; 0 (the default, production): no padding.
PIPELINE_STEP_SCALE=1.0

# Groq (chat completions for the verdict, Whisper for the `transcribe` step). Get a key from
# https://console.groq.com; never commit it.
GROQ_API_KEY=
# Llama 3.3 70B (the P4 brief's original pick) was fully retired from Groq's catalog; this
# is the current free-tier model closest in size/capability.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_API_URL=https://api.groq.com/openai/v1

# Fallbacks for the verdict when Groq fails or runs out of quota, tried in this order, each
# only when its key is set (same OpenAI-style API). Gemini: https://aistudio.google.com
# (free key). OpenRouter: https://openrouter.ai/keys (free models end in `:free`). Each
# *_MODEL is a comma-separated list, tried in order (free models are retired often).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-flash-lite-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free

# Tavily web search (the `sources` step's evidence retrieval, free tier). Get a key from
# https://tavily.com; never commit it.
TAVILY_API_KEY=
# Backup search when Tavily fails or runs out of quota (https://dashboard.exa.ai, free
# monthly credit, no card). Empty: no backup.
EXA_API_KEY=
TAVILY_API_URL=https://api.tavily.com

# Local dedupe embedding (app/providers/embedding.py) — no key, runs on CPU. `stub` (default)
# keeps dev/tests fast; set to `sentence-transformers` to actually load all-MiniLM-L6-v2.
EMBEDDING_PROVIDER=stub
# EMBEDDING_PROVIDER=huggingface runs the same model on Hugging Face's Inference API (what
# production uses: the local model doesn't fit on Render). Read token:
# https://huggingface.co/settings/tokens
HF_TOKEN=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEDUPE_MAX_COSINE_DISTANCE=0.08

# Vector DB for the dedupe lookup (app/providers/vector_db.py). `pgvector` (default) queries
# fact_check_reports.embedding directly — no extra infrastructure. `pinecone` is the
# additive alternative matching §4.2/§4.1 Layer 4's named vector-DB choice; get a key and a
# serverless index host from https://app.pinecone.io (Starter tier is free, no card).
VECTOR_DB_PROVIDER=pgvector
PINECONE_API_KEY=
PINECONE_HOST=

# Local AI-generated-text detector (app/providers/ai_text_detector.py) — no key, runs on CPU.
# `stub` (default) keeps dev/tests fast; set to `roberta` to load the real classifier.
AI_TEXT_DETECTOR_PROVIDER=stub
AI_TEXT_DETECTOR_MODEL=openai-community/roberta-base-openai-detector

# Metadata tampering check for image submissions (app/providers/metadata_integrity.py) — EXIF
# inconsistencies + a SHA-256 content hash, no model, no key. `stub` (default) keeps it off
# until the heuristic has been reviewed; set to `exif` to turn it on.
METADATA_TAMPERING_PROVIDER=stub

# Basic AI-generated-image signal for image submissions (app/providers/deepfake_detector.py),
# from a pretrained (not fine-tuned) classifier — no key, runs on CPU. `stub` (default) keeps
# dev/tests fast; set to `transformers` to load the real classifier.
DEEPFAKE_DETECTOR_PROVIDER=stub
DEEPFAKE_DETECTOR_MODEL=umm-maybe/AI-image-detector
